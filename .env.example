# === OpenRouter / Jev (AI-оценка вакансий, необязательно) ===
# Ключ: https://openrouter.ai/settings/keys . Если пусто — берётся из переменной окружения Windows, иначе AI-этап пропускается.
OPENROUTER_API_KEY=
# Модель Jev на OpenRouter
JEV_MODEL=~typesafe/jev-latest
# Endpoint System One API OpenRouter
JEV_API_URL=https://openrouter.ai/api/v1/systemone
